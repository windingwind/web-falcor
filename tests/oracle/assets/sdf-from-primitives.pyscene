# SDF grid built from a .sdf primitive list (SDFGrid::loadPrimitivesFromFile).
# The file is a CSG solid — a sphere unioned with a 45-degree bar, minus a
# sphere at the top; generate it with: node scripts/gen-assets.mjs sdf
sdfMaterial = Material('SDF Grid')
sdfMaterial.baseColor = float4(0.6, 0.8, 1.0, 1.0)

sdfGrid = SDFGrid.createNDGrid(narrowBandThickness=2.5)
sdfGrid.loadPrimitivesFromFile('sdf/sdf-primitives.sdf', 64)
sceneBuilder.addSDFGridInstance(
    sceneBuilder.addNode('SDFGrid', Transform()),
    sceneBuilder.addSDFGrid(sdfGrid, sdfMaterial)
)

camera = Camera()
camera.position = float3(0, 0, 2)
camera.target = float3(0, 0, 0)
camera.up = float3(0, 1, 0)
sceneBuilder.addCamera(camera)
