#usda 1.0
(
    defaultPrim = "Root"
    upAxis = "Y"
    metersPerUnit = 1
    timeCodesPerSecond = 24
    startTimeCode = 0
    endTimeCode = 36
)
# Curve vertex caches (native's CachedCurve): both curves' points are time-sampled; native
# drops curve1's sample at time code 0 (< 1), lerps positions only (widths stay) and loops
# the curves over their own 1.5s. Every curve is cached: native's update writes cached
# curves from the start of the scene's curve buffer. (Native ignores curves without an extent.)
def "Root"
{
    def Mesh "Floor"
    {
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 3, 2, 1]
        point3f[] points = [(-2, -0.3, -2), (7, -0.3, -2), (7, -0.3, 2), (-2, -0.3, 2)]
    }

    def BasisCurves "curve0"
    {
        uniform token basis = "bspline"
        int[] curveVertexCounts = [5]
        float3[] extent = [(-0.2, -0.2, -0.2), (2.2, 4.2, 1.0)]
        point3f[] points.timeSamples = {
            12: [(0, 0, 0), (0.1, 1, 0.2), (1, 2, 0.4), (1.1, 3, 0.6), (2, 4, 0.8)],
            36: [(0.4, 0, 0), (0.1, 1, 0.6), (0.6, 2, 0.4), (1.5, 3, 0.2), (1.6, 4, 0.8)],
        }
        uniform token type = "cubic"
        float[] widths = [0.1, 0.2, 0.15, 0.3, 0.2] (
            interpolation = "vertex"
        )
        uniform token wrap = "nonperiodic"
    }

    def BasisCurves "curve1"
    {
        uniform token basis = "bspline"
        int[] curveVertexCounts = [5]
        float3[] extent = [(2.5, -0.3, -1.2), (5.8, 4.3, 1.8)]
        point3f[] points.timeSamples = {
            0: [(3.000, 0.000, 0.800), (2.400, 1.000, 1.000), (1.800, 2.000, 1.200), (1.200, 3.000, 1.400), (0.600, 4.000, 1.600)],
            12: [(3.000, 0.000, 0.000), (3.000, 1.000, 0.200), (3.000, 2.000, 0.400), (3.000, 3.000, 0.600), (3.000, 4.000, 0.800)],
            36: [(3.000, 0.000, -0.800), (3.600, 1.000, -0.600), (4.200, 2.000, -0.400), (4.800, 3.000, -0.200), (5.400, 4.000, 0.000)],
        }
        uniform token type = "cubic"
        float[] widths = [0.3, 0.4, 0.3, 0.4, 0.3] (
            interpolation = "vertex"
        )
        uniform token wrap = "nonperiodic"
    }
}
