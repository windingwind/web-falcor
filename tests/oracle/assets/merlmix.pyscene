# MERLMix oracle: a unit quad whose BRDF is chosen per texel from three measured
# MERL BRDFs by an 8x8 index map (texel (x, y) holds the index x + 8y).
# Write the fixtures with: node tools/gen-assets.mjs merl
mixMat = MERLMixMaterial('mix', [
    'merl/merl-lambert.binary',
    'merl/merl-lambert-green.binary',
    'merl/merl-lambert-blue.binary',
])
mixMat.loadTexture(MaterialTextureSlot.Index, 'merl/merl-index-map.tga')

quadMesh = TriangleMesh.createQuad(float2(1.0, 1.0))
meshID = sceneBuilder.addTriangleMesh(quadMesh, mixMat)
nodeID = sceneBuilder.addNode('quad', Transform(translation=float3(0.5, 0.5, 0.0), rotationEulerDeg=float3(90.0, 0.0, 0.0)))
sceneBuilder.addMeshInstance(nodeID, meshID)

light = PointLight('oracleLight')
light.position = float3(0.5, 0.5, 1.5)
light.intensity = float3(3.0, 3.0, 3.0)
sceneBuilder.addLight(light)
