# Spectral parameters in pbrt-v4: every value here is a named, sampled or
# blackbody spectrum, which the importer must turn into RGB the way native's
# spectrumToRGB does (CIE 1931 curves, Rec.709 matrix).
LookAt 0 0 6  0 0 0  0 1 0
Camera "perspective" "float fov" [ 40 ]
WorldBegin

# A constant environment: native builds a one-pixel env map from L.
LightSource "infinite" "spectrum L" "stdillum-D65"

# A distant light whose colour is a 5000 K blackbody.
LightSource "distant" "blackbody L" [ 5000 ] "float scale" [ 2 ] "point3 from" [ 0 0 1 ] "point3 to" [ 0 0 0 ]

AttributeBegin
    Material "conductor" "spectrum eta" "metal-Au-eta" "spectrum k" "metal-Au-k" "float roughness" [ 0 ]
    Shape "sphere" "float radius" [ 1 ]
AttributeEnd

AttributeBegin
    Translate 2 0 0
    Material "diffuse" "spectrum reflectance" [ 400 0.2  550 0.5  700 0.8 ]
    Shape "sphere" "float radius" [ 0.5 ]
AttributeEnd
