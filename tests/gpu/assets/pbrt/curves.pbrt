# pbrt-v4 curve shapes: two straight vertical strands, so the swept surface has
# a closed form. The left one is 0.2 wide; the right one tapers from width0 0.3
# towards width1 0.1 (native interpolates over i / pointCount, so its last
# control point gets 0.15, not 0.1).
LookAt 0 1.5 6  0 1.5 0  0 1 0
Camera "perspective" "float fov" [ 50 ]
WorldBegin

AttributeBegin
    Material "diffuse" "rgb reflectance" [ 0.8 0.2 0.2 ]
    Shape "curve" "point3 P" [ -1 0 0  -1 1 0  -1 2 0  -1 3 0 ] "float width" [ 0.2 ] "string type" "cylinder" "string basis" "bspline"
AttributeEnd

AttributeBegin
    Material "diffuse" "rgb reflectance" [ 0.2 0.2 0.8 ]
    Shape "curve" "point3 P" [ 1 0 0  1 1 0  1 2 0  1 3 0 ] "float width0" [ 0.3 ] "float width1" [ 0.1 ] "string type" "cylinder" "string basis" "bspline"
AttributeEnd
