<?xml version="1.0" encoding="utf-8"?>
<!--
  An environment map emitter with no geometry: the frame is the environment
  itself, so its `scale` factor is directly measurable.
-->
<scene version="3.0.0">
    <sensor type="perspective">
        <float name="fov" value="60"/>
        <transform name="to_world">
            <lookat origin="0, 0, 0" target="0, 0, -1" up="0, 1, 0"/>
        </transform>
        <film type="hdrfilm">
            <integer name="width" value="256"/>
            <integer name="height" value="256"/>
        </film>
    </sensor>

    <emitter type="envmap">
        <string name="filename" value="Arcade/20050806-03_hd.hdr"/>
        <float name="scale" value="1"/>
    </emitter>
</scene>
