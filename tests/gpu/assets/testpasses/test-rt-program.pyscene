# geometry_types.pyscene without its env map (not needed by TestRtProgram),
# plus alpha-masked materials in columns 1 and 2 to exercise the any-hit shaders.

sphereMesh = TriangleMesh.createSphere()

NX = 4
NY = 4
SPACING = 2.5

for x in range(NX):
    material = StandardMaterial('column{}'.format(x))
    # Constant alpha below the 0.5 threshold: AlphaMode::Mask, so any-hit shaders run
    # (the alpha test itself samples the uniform alpha 1 and keeps the hit).
    material.baseColor = float4(0.5, 0.5, 0.5, 0.4 if x in (1, 2) else 1.0)

    sphereMeshID = sceneBuilder.addTriangleMesh(sphereMesh, material)
    for y in range(NY):
        translation = float3(x * SPACING, y * SPACING, 0)
        sceneBuilder.addMeshInstance(sceneBuilder.addNode('column{}'.format(x), Transform(translation=translation)), sphereMeshID)

for x in range(NX):
    for y in range(NY):
        translation = float3((NX + x) * SPACING, y * SPACING, 0)
        sceneBuilder.addCustomPrimitive(x, AABB(translation - 0.25 * SPACING, translation + 0.25 * SPACING))

centerX = 0.5 * SPACING * (2 * NX - 1)
centerY = 0.5 * SPACING * (NY - 1)

camera = Camera()
camera.position = float3(centerX, centerY, 3 * max(centerX, centerY))
camera.target = float3(centerX, centerY, 0)
camera.up = float3(0, 1, 0)
camera.focalLength = 35
sceneBuilder.addCamera(camera)
