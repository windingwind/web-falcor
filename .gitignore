# Upstream Falcor clone (reference; has its own repo)
/Falcor/

# Toolchains (native slangc + slang-wasm; see README for download). Scripts
# that belong in the repo live in scripts/, not here.
/tools/

node_modules/
dist/
*.tsbuildinfo

# Generated shader artifacts — except the shader manifest, which is a tracked
# generated file (like a lockfile): it lists the upstream Falcor shader sources
# so scripts/setup-web.mjs can fetch them without cloning Falcor.
packages/falcor/shaders/generated/*
!packages/falcor/shaders/generated/shader-file-list.json

.vite/
.DS_Store
tests/gpu/out/

# Local scratch dir for throwaway tests / browser-verify tooling
/scratch/
__pycache__/

# Native image-test captures (scripts/capture-native-image-tests.sh); a few small ones are tracked.
tests/oracle/out-native/image-tests/*/*
!tests/oracle/out-native/image-tests/renderpasses/Skinning
!tests/oracle/out-native/image-tests/scene/CameraAnimation
!tests/oracle/out-native/image-tests/scene/USDPreviewSurface
!tests/oracle/out-native/image-tests/scene/Volumes
