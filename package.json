{
  "name": "web-falcor",
  "version": "0.1.2",
  "private": true,
  "description": "WebGPU/WebGL reimplementation of NVIDIA Falcor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup:web": "node scripts/setup-web.mjs",
    "download:scenes": "node scripts/download-scenes.mjs",
    "download:assets": "node scripts/download-assets.mjs",
    "gen:assets": "node scripts/gen-assets.mjs",
    "gen:spectra": "node scripts/gen-spectra.mjs",
    "image-compare": "vite-node scripts/image-compare.ts --",
    "build": "npm run build --workspaces --if-present",
    "shaders": "node packages/slang-compiler/bin/compile-shaders.js",
    "shaders:list": "node packages/slang-compiler/bin/repo-shader-list.js",
    "new:pass": "node scripts/new-pass.mjs",
    "py2js": "vite-node scripts/py2js.ts --",
    "py2js:corpus": "vite-node scripts/py2js.ts -- Falcor/scripts/BSDFViewer.py Falcor/scripts/MinimalPathTracer.py Falcor/scripts/PathTracer.py Falcor/scripts/PathTracerNRD.py Falcor/scripts/RTXDI.py Falcor/scripts/SceneDebugger.py Falcor/scripts/WARDiffPathTracer.py Falcor/media/test_scenes tests/oracle/assets Falcor/tests/image_tests --out tests/gpu/generated/py2js --check",
    "build:web": "node scripts/build-web.mjs",
    "build:packages": "node scripts/build-packages.mjs",
    "release": "node scripts/release.mjs",
    "dev": "npm run dev --workspace=@web-falcor/mogwai",
    "test": "npm run test --workspaces --if-present",
    "test:gpu": "xvfb-run -a node tests/gpu/harness/run.mjs",
    "test:gpu:sw": "node tests/gpu/harness/run.mjs --swiftshader",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@webgpu/types": "^0.1.60",
    "playwright": "^1.61.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "parse-exr": "^1.0.2",
    "pyodide": "^314.0.2"
  }
}
